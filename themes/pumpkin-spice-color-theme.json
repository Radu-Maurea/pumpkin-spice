    "activityBar.inactiveForeground": "#7a6e80",
    "activityBar.activeBorder": "#e8823f",
    "activityBar.border": "#2a2230",
    "activityBarBadge.background": "#e8823f",
    "activityBarBadge.foreground": "#0f0b12",

    "sideBar.background": "#141017",
    "sideBar.foreground": "#d9cfc4",
    "sideBar.border": "#2a2230",
    "sideBarTitle.foreground": "#e8823f",
    "sideBarSectionHeader.background": "#141017",
    "sideBarSectionHeader.foreground": "#eaa66f",
    "sideBarSectionHeader.border": "#2a2230",

    "list.activeSelectionBackground": "#e8823f33",
